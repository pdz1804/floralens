# FloraLens API configuration (copy to .env, never commit .env)
API_HOST=0.0.0.0
API_PORT=8000
# "finetuned_arcface_v1" = Phase 3b promoted candidate (ArcFace head, active
# by default; see ml/eval/reports/promotion_decision.json). Set to "baseline"
# to roll back to the frozen zero-shot backbone with no projection head.
MODEL_VERSION=finetuned_arcface_v1
MODELS_DIR=ml/models
EMBEDDING_BACKBONE=open_clip_vit_b32_laion2b
DATA_DIR=ml/data
GALLERY_MANIFEST=ml/data/manifests/split_manifest.json
EVAL_REPORTS_DIR=ml/eval/reports
