# FloraLens API configuration (copy to .env, never commit .env)
API_HOST=0.0.0.0
API_PORT=8000
# Active ModelVersion (ArcFace head over a frozen backbone). Set to "baseline"
# to roll back to the frozen zero-shot backbone with no projection head.
# See ml/eval/reports/promotion_decision.json for the promotion record and
# ml/models/<version>/model_card.{json,md} for the full model card.
MODEL_VERSION=finetuned_arcface_dinov2_v2
MODELS_DIR=ml/models
# Backbone is auto-selected by ml/embeddings/backbone.py (DINOv3 preferred,
# falls back to DINOv2 ViT-L/14 if DINOv3 weights are gated/unreachable —
# this value is informational only, not read by the loader).
EMBEDDING_BACKBONE=dinov2_vitl14

# Device the embedding backbone (and training runs) execute on: "auto"
# (default) picks CUDA if torch.cuda.is_available() else CPU; "cuda" forces
# GPU (raises if unavailable); "cpu" always forces CPU. See ml/device.py.
FLORALENS_DEVICE=auto

DATA_DIR=ml/data
GALLERY_MANIFEST=ml/data/manifests/split_manifest.json
EVAL_REPORTS_DIR=ml/eval/reports

# MLflow experiment tracking (local, file/sqlite-backed store; see
# ml/tracking/mlflow_utils.py). Training/eval scripts write here directly —
# the `mlflow` docker-compose service only serves the browsable UI over the
# same store and does not need to be running for logging to work.
MLFLOW_TRACKING_URI=sqlite:///infra/mlflow/mlflow.db

# Naturalist assistant (POST /api/assistant) — reuses AgentForge's Unified
# Agent Core (agent_core, installed editable from ../agentforge/packages/
# agent-core, see requirements.txt). Needs an OpenAI key for the naturalist
# manifest's `openai`/gpt-4o-mini provider, and a Tavily key for the shared
# `web_search` tool the assistant cites sources from.
OPENAI_API_KEY=
TAVILY_API_KEY=
